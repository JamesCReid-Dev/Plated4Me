name: plated4me
description: "A privacy-first dining journal for allergy-aware foodies. Log visits, rate experiences, and discover your favorite restaurants — all offline."
publish_to: 'none'

version: 1.0.0+1

environment:
  sdk: ^3.13.7

dependencies:
  flutter:
    sdk: flutter
  flutter_riverpod: ^2.6.1
  cupertino_icons: ^1.0.8
  freezed_annotation: ^2.4.4
  hive: ^2.2.3
  hive_flutter: ^1.1.0
  isar: ^3.1.0+1
  isar_flutter_libs: ^3.1.0+1
  json_annotation: ^4.9.0
  path_provider: ^2.1.5
  riverpod_annotation: ^2.6.1
  uuid: ^4.5.1

dev_dependencies:
  build_runner: ^2.4.13
  freezed: ^2.5.2
  flutter_lints: ^6.0.0
  isar_generator: ^3.1.0+1
  flutter_test:
    sdk: flutter

flutter:
  uses-material-design: true
